datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CREATOR
  SUPER_ADMIN
  OWNER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum ThreatType {
  PHISHING
  MALWARE
  CRYPTO_DRAINER
  SPAM
}

enum SecurityFlagStatus {
  BLOCKED_AUTO
  PENDING_REVIEW
  RESOLVED_BENIGN
  BANNED
}

enum LinkType {
  LINK
  HEADER
  DIVIDER
}

enum BgType {
  SOLID
  GRADIENT
  IMAGE
}

enum BtnStyle {
  FILLED
  OUTLINE
  SHADOW
  ROUNDED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  FACEBOOK
  LINKEDIN
  GITHUB
  TWITCH
  DISCORD
  SPOTIFY
  APPLEMUSIC
  WEBSITE
  EMAIL
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?
  googleId     String?   @unique @map("google_id")
  role         Role      @default(CREATOR)
  isBanned     Boolean   @default(false) @map("is_banned")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  profile        Profile?
  subscriptions  Subscription[]
  securityFlags  SecurityFlag[]
  adminAuditLogs AdminAuditLog[]
  reviewedFlags  SecurityFlag[]    @relation("ReviewedByAdmin")
  addedBlocks    DomainBlocklist[] @relation("AddedByAdmin")

  @@map("users")
}

model Profile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  username     String    @unique @db.VarChar(30)
  title        String?   @db.VarChar(100)
  bio          String?   @db.VarChar(500)
  avatarUrl    String?   @map("avatar_url")
  themeId      String?   @map("theme_id") @db.Uuid
  isPublished  Boolean   @default(false) @map("is_published")
  seoTitle     String?   @map("seo_title") @db.VarChar(60)
  seoDesc      String?   @map("seo_description") @db.VarChar(160)
  ogImageUrl   String?   @map("og_image_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        Theme?       @relation(fields: [themeId], references: [id])
  links        Link[]
  socialLinks  SocialLink[]
  customTheme  CustomTheme?

  @@index([username])
  @@map("profiles")
}

model Link {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  title         String    @db.VarChar(200)
  url           String?
  type          LinkType  @default(LINK)
  position      Int       @default(0)
  thumbnailUrl  String?   @map("thumbnail_url")
  isActive      Boolean   @default(true) @map("is_active")
  clickCount    BigInt    @default(0) @map("click_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
  @@map("links")
}

model Theme {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(50)
  bgType        BgType   @default(SOLID) @map("bg_type")
  bgValue       String   @map("bg_value")
  btnStyle      BtnStyle @default(FILLED) @map("btn_style")
  btnColor      String   @map("btn_color")
  btnTextColor  String   @map("btn_text_color")
  fontFamily    String   @default("Inter") @map("font_family")
  textColor     String   @default("#000000") @map("text_color")
  isDefault     Boolean  @default(false) @map("is_default")
  previewUrl    String?  @map("preview_url")
  createdAt     DateTime @default(now()) @map("created_at")

  profiles      Profile[]

  @@map("themes")
}

model CustomTheme {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @unique @map("profile_id") @db.Uuid
  bgType        BgType   @default(SOLID) @map("bg_type")
  bgValue       String   @map("bg_value")
  btnStyle      BtnStyle @default(FILLED) @map("btn_style")
  btnColor      String   @map("btn_color")
  btnTextColor  String   @map("btn_text_color")
  fontFamily    String   @default("Inter") @map("font_family")
  textColor     String   @default("#000000") @map("text_color")
  btnRadius     Int      @default(8) @map("btn_radius")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("custom_themes")
}

model SocialLink {
  id          String         @id @default(uuid()) @db.Uuid
  profileId   String         @map("profile_id") @db.Uuid
  platform    SocialPlatform
  url         String
  position    Int            @default(0)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")

  profile     Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
  @@map("social_links")
}

model Plan {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(100)
  priceCents    Int          @default(0) @map("price_cents")
  interval      PlanInterval @default(MONTHLY)
  features      Json         @default("{}")
  stripePriceId String?      @unique @map("stripe_price_id")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model SecurityFlag {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  submittedUrl    String             @map("submitted_url")
  riskScore       Decimal            @map("risk_score") @db.Decimal(5, 4)
  threatType      ThreatType         @map("threat_type")
  aiConfidence    Decimal            @map("ai_confidence") @db.Decimal(5, 4)
  ipAddress       String?            @map("ip_address")
  status          SecurityFlagStatus @default(BLOCKED_AUTO)
  reviewedById    String?            @map("reviewed_by") @db.Uuid
  resolutionNotes String?            @map("resolution_notes")
  createdAt       DateTime           @default(now()) @map("created_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?              @relation("ReviewedByAdmin", fields: [reviewedById], references: [id])

  @@index([riskScore])
  @@index([status])
  @@map("security_flags")
}

model DomainBlocklist {
  id            String   @id @default(uuid()) @db.Uuid
  domainPattern String   @unique @map("domain_pattern") @db.VarChar(255)
  reason        String   @db.VarChar(500)
  addedById     String?  @map("added_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  addedBy       User?    @relation("AddedByAdmin", fields: [addedById], references: [id])

  @@map("domain_blocklist")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([action])
  @@map("admin_audit_logs")
}

