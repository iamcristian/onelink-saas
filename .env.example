# ==============================================================================
# Environment Variables Template (Copy to .env for local development)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL="postgresql://dev_user:dev_password@localhost:5432/linktree_dev?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="development_jwt_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="30d"
JWT_REFRESH_SECRET="development_jwt_refresh_secret_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0 (Optional for local testing, required for Google Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Application URLs
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Billing & Subscriptions (Optional for dev simulation, required for real payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_CREATOR_PRO_MONTHLY=""
STRIPE_PRICE_ID_CREATOR_PRO_YEARLY=""
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=""

# Mail / SMTP Notifications (Defaults to MailHog on port 1025 for local development)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OneLink Team <notifications@onelink.bio>"
