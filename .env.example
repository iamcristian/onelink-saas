# ==============================================================================
# Environment Variables Template (Copy to .env for local development)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL="postgresql://dev_user:dev_password@localhost:5432/linktree_dev?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="development_jwt_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="development_jwt_refresh_secret_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0 (Optional for local testing, required for Google Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Application URLs
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
