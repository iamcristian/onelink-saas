{
  "name": "link-in-bio-monorepo",
  "private": true,
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "start:api": "pnpm --filter api start:prod",
    "start:web": "pnpm --filter web start",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @repo/prisma migrate deploy",
    "db:push": "pnpm --filter @repo/prisma db:push",
    "db:seed": "pnpm --filter @repo/prisma db:seed",
    "db:studio": "pnpm --filter @repo/prisma db:studio",
    "db:generate": "pnpm --filter @repo/prisma generate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
